{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ressler-dokumente",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",

  // Oberfläche (HTML, CSS, JavaScript, Schriften) als statische Dateien.
  // Der Worker läuft zuerst, damit /api/... und /sign/... bei ihm landen.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/*", "/sign/*"]
  },

  // Ablage der Dokumente. Der Bucket muss im Dashboard denselben Namen tragen.
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "ressler-dokumente"
    }
  ],

  // Cloudflares eigene KI für die ungarische Übersetzung.
  // Im Gratis-Tarif enthalten: 10.000 Einheiten pro Tag, rund 250 Seiten.
  "ai": { "binding": "AI" },

  // Nächtlicher Aufräumlauf um 03:15 UTC: löscht abgelaufene Vorgänge.
  "triggers": {
    "crons": ["15 3 * * *"]
  },

  // Nicht geheime Einstellungen. Passwörter gehören NICHT hierher,
  // sondern als "Secret" ins Cloudflare-Dashboard.
  "vars": {
    // Adresse für die Benachrichtigung bei eingegangenen Unterschriften.
    // Ohne bestätigte Absenderdomain muss sie mit der Kontoadresse bei
    // Resend übereinstimmen — sonst lehnt Resend die Nachricht ab.
    "NOTIFY_EMAIL": "ressler.versicherung@gmail.com",

    // Nach so vielen Tagen werden abgeschlossene Vorgänge automatisch gelöscht.
    "RETENTION_DAYS": "14",

    "MAIL_FROM_NAME": "Ressler Versicherung",

    // "1" blendet den gesamten E-Mail-Teil aus: Es lassen sich dann nur noch
    // Signaturlinks erzeugen. Sinnvoll, solange keine eigene Absenderdomain
    // bestätigt ist. Die Benachrichtigung an Sie funktioniert trotzdem.
    "LINK_ONLY": "1",

    // KI-Modell für die Übersetzung Deutsch -> Ungarisch.
    "TRANSLATION_MODEL": "@cf/zai-org/glm-4.7-flash"
  },

  "observability": { "enabled": true }
}
